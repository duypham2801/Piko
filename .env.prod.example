# Local production test:
# SITE_ADDRESS=http://localhost
# HTTP_PORT=8080
# HTTPS_PORT=8443
# APP_ORIGIN=http://localhost:8080
# COOKIE_SECURE=false
#
# For a real HTTPS deployment, use your domain, COOKIE_SECURE=true and a
# strong password generated with: openssl rand -hex 32

# API runtime environment.
NODE_ENV=production
# PostgreSQL user.
POSTGRES_USER=piko
# PostgreSQL password. Replace CHANGE_ME before deployment.
POSTGRES_PASSWORD=CHANGE_ME
# PostgreSQL database name.
POSTGRES_DB=piko
# API database connection string. Keep the password in sync above.
DATABASE_URL=postgres://piko:CHANGE_ME@db:5432/piko
# API port inside the container network.
API_PORT=8787
# Public browser origin.
APP_ORIGIN=https://example.com
# Secure cookies are required for HTTPS production.
COOKIE_SECURE=true
# Trust X-Forwarded-For from Caddy.
TRUST_PROXY=true
# Maximum new guest sessions per client IP per hour.
GUEST_RATE_LIMIT_PER_HOUR=20
# Caddy site address. Use a bare domain for automatic HTTPS.
SITE_ADDRESS=example.com
# Email used by Caddy for ACME certificate notices.
ACME_EMAIL=you@example.com
# Host HTTP port.
HTTP_PORT=80
# Host HTTPS port.
HTTPS_PORT=443
