# Runtime mode used by the API.
NODE_ENV=development
# Postgres user used by the development database container.
POSTGRES_USER=piko
# Development-only Postgres password.
POSTGRES_PASSWORD=piko_dev_password
# Postgres database name.
POSTGRES_DB=piko
# API connection string; the db hostname is the Compose service name.
DATABASE_URL=postgres://piko:piko_dev_password@db:5432/piko
# Port exposed by the API container.
API_PORT=8787
# Browser origin accepted by the API.
APP_ORIGIN=http://localhost:5173
# Optional, dev only: open the web app from other devices (D-034).
# DEV_WEB_BIND also publishes port 5173 on this machine's LAN IPv4 (localhost keeps working).
# Not needed for Tailscale Serve, which proxies to localhost:5173.
# DEV_WEB_BIND=192.168.1.100
# Comma-separated origins the API accepts writes from and Vite accepts as hosts:
# the LAN address above and/or a Tailscale Serve name (https://<machine>.<tailnet>.ts.net).
# DEV_EXTRA_ORIGINS=http://192.168.1.100:5173,https://my-pc.example-tailnet.ts.net
# Set true only when serving over HTTPS.
COOKIE_SECURE=false
# Trust X-Forwarded-For only behind a trusted proxy.
TRUST_PROXY=false
# Version reported by the health endpoint.
APP_VERSION=dev
# Maximum new guest sessions per client IP per hour.
GUEST_RATE_LIMIT_PER_HOUR=20
# Enable polling for Vite file watching when bind mounts need it.
VITE_USE_POLLING=false
# API URL used by the Vite development proxy outside Docker.
API_PROXY_TARGET=http://localhost:8787
