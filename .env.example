# Runtime mode used by the API.
NODE_ENV=development
# Postgres user used by the development database container.
POSTGRES_USER=wswd
# Development-only Postgres password.
POSTGRES_PASSWORD=wswd_dev_password
# Postgres database name.
POSTGRES_DB=wswd
# API connection string; the db hostname is the Compose service name.
DATABASE_URL=postgres://wswd:wswd_dev_password@db:5432/wswd
# Port exposed by the API container.
API_PORT=8787
# Browser origin accepted by the API.
APP_ORIGIN=http://localhost:5173
# Set true only when serving over HTTPS.
COOKIE_SECURE=false
# Trust X-Forwarded-For only behind a trusted proxy.
TRUST_PROXY=false
# Version reported by the health endpoint.
APP_VERSION=dev
# Maximum new guest sessions per client IP per hour.
GUEST_RATE_LIMIT_PER_HOUR=20
# Enable polling for Vite file watching when bind mounts need it.
VITE_USE_POLLING=false
# API URL used by the Vite development proxy outside Docker.
API_PROXY_TARGET=http://localhost:8787
