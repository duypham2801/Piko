{
  "name": "@wswd/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@wswd/domain": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
